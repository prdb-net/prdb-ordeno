<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Prdb.Sdk" Version="0.9.0" />
    <PackageVersion Include="Prdb.Hashing" Version="0.1.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <!-- For PasswordHasher<T>; ADR 0010 names it. Brings no identity system with it. -->
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <!-- ADR 0014: the document the frontend's types are generated from. -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!-- Writes that document at build time, without the application running. -->
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.10" />
    <!--
      Microsoft.AspNetCore.OpenApi 10.0.10 still pulls Microsoft.OpenApi 2.0.0,
      which carries GHSA-v5pm-xwqc-g5wc. Referencing a patched 2.x directly
      overrides it; the pin goes when ASP.NET Core ships one that no longer
      needs it.
    -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.11.0" />
    <!--
      EF Core 10.0.10 still pulls SQLitePCLRaw 2.1.11, whose bundled SQLite
      carries GHSA-2m69-gcr7-jv3q. Referencing the 3.x bundle directly overrides
      that; the pin goes when EF ships a version that no longer needs it.
    -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>
