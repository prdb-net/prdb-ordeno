                "schema": {
                  "$ref": "#/components/schemas/ConfigurationState"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigurationProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/configuration/sources": {
      "post": {
        "tags": [
