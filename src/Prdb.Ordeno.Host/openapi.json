  "components": {
    "schemas": {
      "AccessState": {
        "required": [
          "passwordSet",
          "authenticated"
        ],
        "type": "object",
        "properties": {
          "passwordSet": {
            "type": "boolean"
          },
          "authenticated": {
            "type": "boolean"
          }
        }
      },
      "AddSourceRequest": {
        "required": [
          "path"
        ],
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        }
      },
      "ConfigurationProblem": {
        "required": [
          "message",
          "configuration"
        ],
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "configuration": {
            "$ref": "#/components/schemas/ConfigurationState"
          }
        }
      },
      "ConfigurationState": {
        "required": [
          "apiKeySet",
          "sources",
          "target",
          "layout",
          "availableLayouts",
          "complete",
          "readyToComplete",
          "whatHappensNext"
        ],
        "type": "object",
        "properties": {
          "apiKeySet": {
            "type": "boolean"
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceState"
            }
          },
          "target": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/DirectoryState"
              }
            ]
          },
          "layout": {
            "type": [
              "null",
              "string"
            ]
          },
          "availableLayouts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LayoutOption"
            }
          },
          "complete": {
            "type": "boolean"
          },
          "readyToComplete": {
            "type": "boolean"
          },
          "whatHappensNext": {
            "type": "string"
          }
        }
      },
      "DirectoryState": {
        "required": [
          "path",
          "usable",
          "problem"
        ],
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "usable": {
            "type": "boolean"
          },
          "problem": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "HealthResponse": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "LayoutOption": {
        "required": [
          "name",
          "description"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "ProblemResponse": {
        "required": [
          "message"
        ],
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "ScannedFileState": {
        "required": [
          "id",
          "sourceId",
          "path",
          "name",
          "sizeBytes",
          "ready",
          "firstSeenAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "sourceId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "path": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "sizeBytes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "ready": {
            "type": "boolean"
          },
          "firstSeenAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ScannedSourceState": {
        "required": [
          "sourceId",
          "path",
          "reachable",
          "problem",
          "ready",
          "settling",
          "total"
        ],
        "type": "object",
        "properties": {
          "sourceId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "path": {
            "type": "string"
          },
          "reachable": {
            "type": "boolean"
          },
          "problem": {
            "type": [
              "null",
              "string"
            ]
          },
          "ready": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "settling": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "total": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "ScanState": {
        "required": [
          "scanning",
          "lastScanStartedAt",
          "lastScanFinishedAt",
          "problem",
          "onboardingComplete",
          "sources",
          "files",
          "ready",
          "settling",
          "total",
          "whatItFound"
        ],
        "type": "object",
        "properties": {
          "scanning": {
            "type": "boolean"
          },
          "lastScanStartedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "lastScanFinishedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "problem": {
            "type": [
              "null",
              "string"
            ]
          },
          "onboardingComplete": {
            "type": "boolean"
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScannedSourceState"
            }
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScannedFileState"
            }
          },
          "ready": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "settling": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "total": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "whatItFound": {
            "type": "string"
          }
        }
      },
      "SetApiKeyRequest": {
        "required": [
          "apiKey"
        ],
        "type": "object",
        "properties": {
          "apiKey": {
            "type": "string"
          }
        }
      },
      "SetPasswordRequest": {
        "required": [
          "password"
        ],
        "type": "object",
        "properties": {
          "password": {
            "type": "string"
          }
        }
      },
      "SetTargetRequest": {
        "required": [
          "path",
          "layout"
        ],
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "layout": {
            "type": "string"
          }
        }
      },
      "SignInRequest": {
        "required": [
          "password"
        ],
        "type": "object",
        "properties": {
          "password": {
            "type": "string"
          }
        }
      },
      "SourceState": {
        "required": [
          "id",
          "path",
          "usable",
          "problem",
          "movement",
          "movementExplained"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "path": {
            "type": "string"
          },
          "usable": {
            "type": "boolean"
          },
          "problem": {
            "type": [
              "null",
              "string"
            ]
          },
          "movement": {
            "type": "string"
          },
          "movementExplained": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Health"
    },
    {
      "name": "Access"
    },
    {
      "name": "Configuration"
    },
    {
      "name": "Scanning"
    }
  ]
}